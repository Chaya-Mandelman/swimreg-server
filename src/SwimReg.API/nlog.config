<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- כל שורת לוג כוללת את ה-CorrelationId של הבקשה -->
  <variable name="layout"
            value="${longdate}|${level:uppercase=true}|${scopeproperty:CorrelationId}|${logger}|${message}${onexception:inner=${newline}${exception:format=tostring}}" />

  <targets>
    <target xsi:type="Console" name="console" layout="${layout}" />

    <!-- קובץ חדש לכל יום -->
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/swimreg-${shortdate}.log"
            layout="${layout}"
            encoding="utf-8"
            maxArchiveDays="14" />
  </targets>

  <rules>
    <!-- הסינון לפי רמות נעשה בסעיף Logging של appsettings -->
    <logger name="*" minlevel="Trace" writeTo="console,file" />
  </rules>
</nlog>
